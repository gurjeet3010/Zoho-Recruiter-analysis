# Zoho Recruit OAuth 2.0 Credentials
# Obtain these from Zoho Developer Console (https://api-console.zoho.com/)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REGION=in
ZOHO_SERVICE=recruit

# Optional: Pre-configured tokens if running in production (e.g., Render/Railway)
ZOHO_REFRESH_TOKEN=
ZOHO_ACCESS_TOKEN=
ZOHO_ACCESS_TOKEN_EXPIRES_AT=
